# Copy to tools/overpass/.env (ignored by git) and set the paths.
# Docker Compose reads this file for docker-compose.yml.

# The folder on Windows that holds the planet PBF (forward slashes), read
# only: the import reads it once, in order.
PLANET_DIR=E:/gev-data/osm

# The PBF's name in that folder: the dated file the README downloads.
PLANET_FILE=planet-261012.osm.pbf

# The port on 127.0.0.1 the server answers on.
OVERPASS_PORT=12345

# The database is not a path here: it is the gev-overpass-db volume, inside
# Docker Desktop's disk image (Settings > Resources > Advanced > Disk image
# location: D:\DockerDesktop\DockerDesktopWSL).
