# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
# Personal fork: service-account keys (Earth Engine); never committed.
.gev-secrets/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# Transient: a release interrupted mid-assembly (npm run changelog recovers it)
changelog.d/.assembling/

# Personal fork: local credential files (Earth Engine service-account key); never committed
.gev-secrets/

# Personal fork: Cottereau's extracted borders are private (personal use
# only): no build, sample or Cliopatria cut of one may ever be tracked.
/data/cottereau/borders/
/.gev-cache/cottereau/
**/samples/[0-9][0-9][0-9][0-9].json.gz
**/cliopatria.f64

# Claude Code session folders: worktrees, launch config, harness screenshots
.claude/
